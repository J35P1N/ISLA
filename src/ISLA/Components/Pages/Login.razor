@page "/login"
<PageTitle>Sign in | ISLA</PageTitle>
<div class="page-intro mx-auto max-w-xl space-y-4">
    <h1>Sign in to ISLA</h1>
    @if (Failed is not null) { <p role="alert">Sign-in failed. Check your credentials or wait 15 minutes if your account is locked.</p> }
    <form method="post" action="/account/login" class="space-y-4" data-enhance="false">
        <AntiforgeryToken />
        <label class="block">Username<input class="field" name="username" autocomplete="username" required maxlength="100" /></label>
        <label class="block">Password<input class="field" name="password" type="password" autocomplete="current-password" required maxlength="256" /></label>
        <label class="block"><input type="checkbox" name="remember" value="true" /> Remember this browser for 90 days</label>
        <p>Remembered sign-ins expire 90 days after signing in. Leave unchecked on shared devices.</p>
        <button class="primary-button">Sign in</button>
    </form>
</div>
@code { [SupplyParameterFromQuery(Name = "failed")] public string? Failed { get; set; } }
