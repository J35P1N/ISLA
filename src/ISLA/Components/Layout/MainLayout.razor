@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-2 focus:z-50 focus:rounded-md focus:bg-white focus:p-3">Skip to content</a>

<div class="app-shell min-h-dvh bg-slate-50 text-slate-900">
    <header class="brand-header border-b border-slate-200 bg-white px-4 py-4 sm:px-6">
        <div class="mx-auto max-w-6xl">
            <a class="inline-flex items-center gap-3" href="" aria-label="ISLA home">
                <span class="brand-mark" aria-hidden="true">
                    <img class="size-full object-cover" src="images/isla-mascot.webp" width="56" height="56" alt="" fetchpriority="high" />
                </span>
                <span class="min-w-0"><span class="brand-wordmark block">ISLA<span class="text-[#9671a7]">.</span></span><span class="brand-caption block">Indespensible Shopping List Application</span></span>
            </a>
        </div>
    </header>
    <main id="main-content" class="min-w-0">
        <article class="mx-auto max-w-6xl space-y-5 px-4 py-5 sm:space-y-6 sm:px-6 sm:py-8">
            @Body
        </article>
    </main>
    <AuthorizeView><Authorized><NavMenu /></Authorized></AuthorizeView>
</div>

<div id="blazor-error-ui" class="fixed inset-x-0 top-0 z-50 hidden bg-amber-100 px-6 py-4 pr-12 text-amber-950" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload underline">Reload</a>
    <button type="button" class="dismiss absolute right-2 top-1 min-h-11 min-w-11 cursor-pointer" aria-label="Dismiss error">&#x2715;</button>
</div>
