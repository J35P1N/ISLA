<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Generate CSS before static web assets are discovered, including on first build. -->
  <Target Name="BuildTailwind" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipTailwind)' != 'true'">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="!Exists('$(MSBuildProjectDirectory)/node_modules/.package-lock.json')" />
    <Exec Command="npm run css:build" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Content Remove="wwwroot/app.css" />
      <Content Include="wwwroot/app.css" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
