@page "/setup"
@rendermode InteractiveServer
@using ISLA.Security
@inject SetupService Wizard
@inject SignInNavigation Navigation
<PageTitle>Set up ISLA</PageTitle>
<div class="page-intro mx-auto max-w-xl space-y-4">
    <p class="eyebrow">Welcome to your household</p>
    <h1>Set up ISLA</h1>
    @if (!Wizard.HasToken)
    {
        <p>Restart ISLA and check the server console for the first-run setup token.</p>
    }
    else
    {
        <p>Step @step of 4</p>
        @if (error is not null) { <p role="alert" class="text-red-700">@error</p><p>If setup completed, <a href="/login" class="underline">sign in</a>.</p> }
        <form @onsubmit="Next" @onsubmit:preventDefault>
            @if (step == 1)
            {
                <p>Copy the first-run setup token printed in the terminal where ISLA is running. In Docker, find it in the application logs. This confirms you have access to the server.</p>
                <p>If the operator supplied a token through configuration, use that token instead.</p>
                <label>Operator setup token<input class="field" type="password" @bind="token" autocomplete="off" required /></label>
            }
            else if (step == 2)
            {
                <h2>Choose storage</h2>
                <label class="block"><input type="radio" checked disabled /> Simple — JSON files</label>
                <p>One running ISLA instance. Household data, accounts and browser sessions persist in the operator-configured data directory. In Docker, mount a persistent volume at /app/data.</p>
                <p>SQLite and external databases will be available in later stages.</p>
            }
            else if (step == 3)
            {
                <h2>Create the administrator</h2>
                <label>Username<input class="field" @bind="username" autocomplete="username" required maxlength="100" /></label>
                <label>Password<input class="field" type="password" @bind="password" autocomplete="new-password" required minlength="12" maxlength="256" /></label>
                <label>Confirm password<input class="field" type="password" @bind="confirm" autocomplete="new-password" required /></label>
            }
            else
            {
                <h2>Review and initialise</h2>
                <p>Administrator: <strong>@username</strong></p>
                <p>Storage: Simple JSON. Existing household data will be kept, with a backup before setup completes.</p>
                <p>Everyone will need to sign in. You can create members in Settings.</p>
            }
            <button class="primary-button mt-4" disabled="@(busy || !ready)">@(step == 4 ? "Initialise ISLA" : step == 2 ? "Validate storage and continue" : "Continue")</button>
        </form>
    }
</div>
@code {
    private int step = 1;
    private string token = "", username = "", password = "", confirm = "";
    private string? error;
    private bool busy, ready;
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { ready = true; StateHasChanged(); }
    }
    private async Task Next()
    {
        if (busy) return;
        busy = true; error = null;
        try
        {
            if (step == 1 && !await Wizard.VerifyAsync(token)) throw new ArgumentException("Token rejected. Check the operator token or wait if too many attempts were made.");
            if (step == 2) await Wizard.ValidateStorageAsync(token);
            if (step == 3) { Accounts.Validate(username, password); if (password != confirm) throw new ArgumentException("Passwords do not match."); }
            if (step < 4) step++;
            else { await Wizard.CompleteAsync(token, username, password); password = confirm = token = ""; await Navigation.GoToLoginAsync(); }
        }
        catch (Exception ex) when (ex is ArgumentException or IOException or UnauthorizedAccessException or InvalidDataException or System.Text.Json.JsonException) { error = ex is ArgumentException ? ex.Message : "Storage validation failed. Ask the operator to check the data directory and existing files."; }
        finally { busy = false; }
    }
}
